# Deepgram STT
DEEPGRAM_API_KEY=your_deepgram_api_key

# ElevenLabs TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Anthropic LLM
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Daily Configuration
DAILY_SAMPLE_ROOM_URL=https://your-domain.daily.co/room-name
DAILY_TOKEN=your_daily_room_token
DAILY_API_KEY=your_daily_api_key

# Google Calendar
# Option 1: Service account credentials JSON file path
GOOGLE_CALENDAR_CREDENTIALS_PATH=./credentials/service-account.json

# Option 2: Service account credentials JSON as string (alternative to file path)
# GOOGLE_CALENDAR_CREDENTIALS_JSON={"type":"service_account",...}

# Option 3: OAuth token file path (for user authentication)
# GOOGLE_CALENDAR_TOKEN_PATH=./credentials/token.json

# Calendar ID (default: "primary" for primary calendar)
GOOGLE_CALENDAR_ID=primary

# RAG Configuration
CHROMA_DB_PATH=./chroma_db
MENU_DATA_PATH=./data/sample_menu.json

# VAD Configuration
VAD_SENSITIVITY=0.5

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
